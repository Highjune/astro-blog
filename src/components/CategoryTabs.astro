---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { postFilter } from "@/utils/postFilter";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  /** Slug of the selected category. Omit for "all". */
  active?: string;
};

const { active } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts", ({ data }) => !data.draft);
const categories = getUniqueCategories(posts);
const total = posts.filter(postFilter).length;

const tabs = [
  {
    key: "",
    label: t.pages.categoryAll,
    count: total,
    href: getRelativeLocaleUrl(locale, "posts"),
  },
  ...categories.map(({ category, categoryName, count }) => ({
    key: category,
    label: categoryName,
    count,
    href: getRelativeLocaleUrl(locale, `categories/${category}/`),
  })),
];
const current = active ?? "";
---

<nav aria-label={t.nav.categories} class="category-tabs -mx-4 sm:mx-0">
  <ul
    class="flex gap-2 overflow-x-auto px-4 py-3 sm:flex-wrap sm:overflow-visible sm:px-0"
  >
    {
      tabs.map(({ key, label, count, href }) => (
        <li class="shrink-0">
          <a
            href={href}
            aria-current={key === current ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm whitespace-nowrap",
              "focus-visible:outline-accent focus-visible:outline-2",
              key === current
                ? "bg-accent text-accent-foreground border-accent font-semibold"
                : "border-border hover:border-accent hover:text-accent",
            ]}
          >
            {label}
            <span class:list={["text-xs", key === current ? "opacity-90" : "opacity-60"]}>
              {count}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Keep the selected tab visible on narrow screens (horizontal scroll).
  document.addEventListener("astro:page-load", () => {
    const selected = document.querySelector<HTMLElement>(
      '.category-tabs a[aria-current="page"]'
    );
    selected?.scrollIntoView({ block: "nearest", inline: "center" });
  });
</script>
