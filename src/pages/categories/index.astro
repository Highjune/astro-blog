---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueCategories } from "@/utils/getUniqueCategories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const categories = getUniqueCategories(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {
        categories.map(({ category, categoryName, count }) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `categories/${category}/`)}
              class="border-border hover:border-accent hover:text-accent focus-visible:outline-accent flex items-center justify-between rounded-lg border px-4 py-3 focus-visible:outline-2"
            >
              <span class="font-medium">{categoryName}</span>
              <span class="text-sm opacity-60">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
